
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        height: 100%;
        font-family: 'Segoe UI', sans-serif;
    }

    body {
        background: radial-gradient(#e4ddff 1px, transparent 1px);
        background-size: 14px 14px;
        background-color: #f8f6ff;
    }

    /* Full screen center */
    .expired-page {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
    }

    /* Content wrapper */
    .expired-card {
        text-align: center;
        max-width: 420px;
        width: 100%;
    }

    /* Icon */
    .icon-wrapper {
        width: 100px;
        height: 100px;
        margin: 0 auto 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient( 135deg, #f4c430, #b8860b );
        color: #fff;
        font-size: 46px;
        box-shadow: 0 12px 30px rgba(184, 134, 11, 0.25);
    }

    /* Heading */
    .expired-card h2 {
        color: #1f2937;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    /* Description */
    .expired-card p {
        color: #6b7280;
        font-size: 15px;
        line-height: 1.7;
        max-width: 360px;
        margin: 0 auto;
    }

    /* Tablet */
    @@media (max-width: 768px) {
        .icon-wrapper

    {
        width: 90px;
        height: 90px;
        font-size: 40px;
    }

    .expired-card h2 {
        font-size: 28px;
    }

    .expired-card p {
        font-size: 14px;
    }

    }

    /* Mobile */
    @@media (max-width: 480px) {
        .expired-page

    {
        padding: 20px;
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        font-size: 34px;
        margin-bottom: 20px;
    }

    .expired-card h2 {
        font-size: 24px;
        margin-bottom: 12px;
    }

    .expired-card p {
        font-size: 14px;
        line-height: 1.6;
    }

    }
</style>
<div class="expired-page">

    <div class="expired-card">

        <div class="icon-wrapper">
            ⌛
        </div>

        <h2>The URL has expired!</h2>

        <p>
            The selfie upload URL you want to access has expired.
            Kindly click 'Send Again' on TrucksUp app to get a fresh URL.
        </p>

    </div>

</div>

